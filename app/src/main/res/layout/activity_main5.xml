<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/cuero">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_titulo"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/texto_fondo" />

    <TextView
        android:id="@+id/tvUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="16dp"
        android:textColor="@color/tinta"
        android:background="@drawable/bg_campo" />

    <!-- Notificaciones -->
    <Switch
        android:id="@+id/swNotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:text="@string/notificaciones"
        android:textColor="@color/tinta"
        android:background="@drawable/bg_campo" />

    <!-- Modo oscuro / claro -->
    <Button
        android:id="@+id/btnCambiarTema"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/modo_claro"
        android:textColor="@color/tinta"
        android:backgroundTint="@color/dorado" />

    <!-- Idioma -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/idioma_label"
        android:textColor="@color/texto_fondo" />

    <Spinner
        android:id="@+id/spIdioma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_campo"
        android:popupBackground="@color/pergamino" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnCerrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_cerrar"
        android:textColor="@color/tinta"
        android:backgroundTint="@color/dorado" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/cuero">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuraciones"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/pergamino" />

    <!-- Interruptor de notificaciones. Es de adorno (no hace nada todavía),
         pero ya queda como en el diseño de Figma. -->
    <Switch
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="16dp"
        android:text="Notificaciones"
        android:textColor="@color/tinta"
        android:background="@drawable/bg_campo" />

    <!-- Este espacio vacío empuja el botón hasta abajo (weight=1 = ocupa lo que sobre) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnCerrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar sesión"
        android:textColor="@color/tinta"
        android:backgroundTint="@color/dorado" />
</LinearLayout>
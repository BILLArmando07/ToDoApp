<?xml version="1.0" encoding="utf-8"?>
<!-- Un "shape" es una figura dibujada con código, sin necesidad de imágenes -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Relleno color pergamino -->
    <solid android:color="#F2E6C8"/>
    <!-- Borde café de 1dp (dp es la unidad de medida en Android) -->
    <stroke android:width="1dp" android:color="#8B6B43"/>
    <!-- Esquinas casi cuadradas -->
    <corners android:radius="6dp"/>
</shape>